# Minecraft接続設定（必須）
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=your-email@example.com

# Minecraft接続設定（オプション）
MC_VERSION=1.21.4
MC_AUTH=microsoft  # mojang, microsoft, offline

# Claude AI設定（オプション）
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MATCH_KEYWORD=temzin
# CLAUDE_SYSTEM_ROLE_CONTENT=あなたはtemzinという名前のアシスタントAIです。
# CLAUDE_USER_ROLE_CONTENT_PREFIX=
# CLAUDE_USER_ROLE_CONTENT_POSTFIX=100～200文字程度にまとめて回答してください。
# CLAUDE_MODEL_NAME=claude-haiku-5-5

# Gemini AI設定（オプション）
# GEMINI_API_KEY=...
# GEMINI_MATCH_KEYWORD=gemini
# GEMINI_SYSTEM_ROLE_CONTENT=あなたはtemzinという名前のアシスタントAIです。
# GEMINI_USER_ROLE_CONTENT_PREFIX=
# GEMINI_USER_ROLE_CONTENT_POSTFIX=100～200文字程度にまとめて回答してください。
# GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# OpenAI設定（オプション）
# OPENAI_API_KEY=sk-...
# OPENAI_MATCH_KEYWORD=gpt
# OPENAI_SYSTEM_ROLE_CONTENT=あなたはtemzinという名前のアシスタントAIです。
# OPENAI_USER_ROLE_CONTENT_PREFIX=
# OPENAI_USER_ROLE_CONTENT_POSTFIX=100～200文字程度にまとめて回答してください。
# OPENAI_MODEL_NAME=gpt-4-turbo

# Open WebUI設定（オプション）
# OPENWEBUI_API_KEY=sk-...
# OPENWEBUI_BASE_URL=http://your-open-webui-host:3000/api
# OPENWEBUI_MATCH_KEYWORD=temzin
# OPENWEBUI_SYSTEM_ROLE_CONTENT=あなたはtemzinという名前のアシスタントAIです。
# OPENWEBUI_USER_ROLE_CONTENT_PREFIX=
# OPENWEBUI_USER_ROLE_CONTENT_POSTFIX=100～200文字程度にまとめて回答してください。
# OPENWEBUI_MODEL_NAME=gemma4:12b
